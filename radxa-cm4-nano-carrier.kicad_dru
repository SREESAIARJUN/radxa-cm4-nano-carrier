(version 1)

# Rev 7 mechanical rules: 55.0 x 40.0 mm CM4 envelope, zero overhang.
# Every rule below is proven live by a mutation test in tools/verify_outline.py.

# Any copper (tracks, vias, pads, pours) on any layer stays >= 0.30 mm from Edge.Cuts.
(rule "board_edge_copper"
  (constraint edge_clearance (min 0.3mm))
)

# NPTH drill wall to board edge >= 1x board thickness (1.6 mm): prevents web
# cracking under screw torque / depanelisation.  KiCad 8 does not apply
# edge_clearance to copper-less NPTH holes, so this must be a hole clearance
# scoped to Edge.Cuts.  Measured to the Edge.Cuts stroke edge (0.025 mm inboard):
# M2.5 @ 3.5 mm inset, 2.7 mm drill -> 2.125 mm.  Legacy 2.25 mm inset -> 0.875 mm (fails).
(rule "npth_edge_web"
  (condition "A.Pad_Type == 'NPTH, mechanical' && B.Layer == 'Edge.Cuts'")
  (constraint physical_hole_clearance (min 1.6mm))
)






# ---- BEGIN Rev 11 HDMI0 TMDS (generated by tools/hdmi_tmds.py) ----
# 100 ohm differential (W 0.165 / S 0.125 mm, FD-solved, see tools/hdmi_tmds.py).
# Intra-pair: KiCad 8 'skew' is measured against the AVERAGE of the nets the rule
# matches. With exactly P and N in a group each deviates by |P-N|/2, so
# max 0.075 mm  <=>  |P - N| <= 0.15 mm.
(rule "hdmi0_tmds_skew_TX2"
  (condition "A.NetName == 'HDMI0_TX2_P' || A.NetName == 'HDMI0_TX2_N'")
  (constraint skew (max 0.075mm)))
(rule "hdmi0_tmds_skew_TX1"
  (condition "A.NetName == 'HDMI0_TX1_P' || A.NetName == 'HDMI0_TX1_N'")
  (constraint skew (max 0.075mm)))
(rule "hdmi0_tmds_skew_TX0"
  (condition "A.NetName == 'HDMI0_TX0_P' || A.NetName == 'HDMI0_TX0_N'")
  (constraint skew (max 0.075mm)))
(rule "hdmi0_tmds_skew_CLK"
  (condition "A.NetName == 'HDMI0_CLK_P' || A.NetName == 'HDMI0_CLK_N'")
  (constraint skew (max 0.075mm)))

# Inter-pair: a +/-0.075 mm length window on all 8 nets (KiCad length incl. the
# 1.551 mm via barrel) bounds max-min <= 0.15 mm across all four pairs.
(rule "hdmi0_tmds_length_window"
  (condition "A.NetName == 'HDMI0_TX2_P' || A.NetName == 'HDMI0_TX2_N' || A.NetName == 'HDMI0_TX1_P' || A.NetName == 'HDMI0_TX1_N' || A.NetName == 'HDMI0_TX0_P' || A.NetName == 'HDMI0_TX0_N' || A.NetName == 'HDMI0_CLK_P' || A.NetName == 'HDMI0_CLK_N'")
  (constraint length (min 46.6016mm) (max 46.7516mm)))

(rule "hdmi0_tmds_width"
  (condition "A.NetClass == 'HDMI_TMDS'")
  (constraint track_width (min 0.160mm) (opt 0.165mm) (max 0.170mm)))

# min = fab floor for the 100-ohm gap. max admits the single-trace phase bumps
# (gap 0.125 + h <= 0.20 mm); the exact 0.125 mm on coupled runs is checked by
# `hdmi_tmds.py verify` on the copper itself.
# Uncoupled: KiCad 8 counts pad/via fan-outs, the 0.6-0.8 mm phase bumps and the
# partially-overlapping 45-deg chamfer segments as uncoupled (5-8 mm measured).
# Each individual uncoupled feature is < 0.9 mm (< 5 ps, << 50 ps edge); the
# rule catches gross de-coupling such as a pair split around an obstacle.
(rule "hdmi0_tmds_dp_gap"
  (condition "A.NetClass == 'HDMI_TMDS' && A.inDiffPair('*')")
  (constraint diff_pair_gap (min 0.115mm) (opt 0.125mm) (max 0.355mm))
  (constraint diff_pair_uncoupled (max 8.5mm)))

# TMDS copper keeps 0.2 mm from every non-TMDS item (GND stitching, pads, vias).
(rule "hdmi0_tmds_to_other"
  (condition "A.NetClass == 'HDMI_TMDS' && B.NetClass != 'HDMI_TMDS'")
  (constraint clearance (min 0.2mm)))

# Every TMDS net changes layer exactly once (F.Cu <-> B.Cu through via).
(rule "hdmi0_tmds_one_via"
  (condition "A.NetClass == 'HDMI_TMDS'")
  (constraint via_count (max 1)))
# ---- END Rev 11 HDMI0 TMDS ----

# ---- BEGIN Rev 13 SY8089 buck (generated by tools/buck_3v3.py) ----
# FB is a 18 kOhm node: keep it >= 1.0 mm from the 1 MHz / 5 V LX node (datasheet layout rule 4).
(rule "buck_fb_lx_isolation"
  (condition "A.NetName == 'BUCK_FB' && B.NetName == 'BUCK_LX'")
  (constraint clearance (min 1.0mm)))

# High-current conductors of the power stage: no neck-downs below 0.55 mm.
# Scoped to this stage's group so the J1 DF40 0.2 mm +5V_IN pad fan-out (other stages) is not caught.
(rule "buck_power_width"
  (condition "A.Type == 'Track' && A.memberOfGroup('REV13_BUCK_3V3') && (A.NetName == 'BUCK_LX' || A.NetName == '+5V_IN')")
  (constraint track_width (min 0.55mm)))
# ---- END Rev 13 SY8089 buck ----

# >>> Rev 9 Ethernet MDI rules (generated by tools/ethernet_mdi.py) >>>
# 100-ohm MDI geometry: W 0.165 / S 0.125 mm on L1/L4 (tools/mdi_impedance.py).
(rule "mdi_diffpair_geometry"
  (condition "(A.NetName == 'Ethernet_Pair*' || A.NetName == 'ETH_MDI*')")
  (constraint track_width (min 0.155mm) (opt 0.165mm) (max 0.175mm))
  (constraint diff_pair_gap (min 0.115mm) (opt 0.125mm) (max 0.485mm))
  # gap max admits the 0.35 mm skew trombones; nominal 0.125 coupling is generated + verified
  (constraint diff_pair_uncoupled (max 10.0mm))
  (constraint length (max 50.0mm))
  (constraint via_count (max 2)))

# P-N of the same pair: the coupled gap S sets the clearance (independent of any netclass).
(rule "mdi_intrapair"
  (condition "(A.NetName == 'Ethernet_Pair*' || A.NetName == 'ETH_MDI*') && A.isCoupledDiffPair()")
  (constraint clearance (min 0.120mm)))

# MDI copper keeps >= 0.30 mm (~1.4 h, > 2 W) from every other net's tracks, vias and
# plane edges.  Pads are excluded: the DF40 (0.4 mm pitch) and transformer pad fields
# set their own spacing (0.20 mm default clearance applies there).
(rule "mdi_isolation"
  (condition "(A.NetName == 'Ethernet_Pair*' || A.NetName == 'ETH_MDI*') && A.Type != 'Pad' && B.Type != 'Pad' && !(B.NetName == 'Ethernet_Pair*' || B.NetName == 'ETH_MDI*')")
  (constraint clearance (min 0.30mm)))

# Pair-to-pair spacing (different MDI pairs, track/via only).
(rule "mdi_interpair"
  (condition "(A.NetName == 'Ethernet_Pair*' || A.NetName == 'ETH_MDI*') && (B.NetName == 'Ethernet_Pair*' || B.NetName == 'ETH_MDI*') && !A.isCoupledDiffPair() && A.Type != 'Pad' && B.Type != 'Pad'")
  (constraint clearance (min 0.30mm)))

# Intra-pair skew <= 0.15 mm.  KiCad 8 measures skew as each net's deviation from the
# rule-group AVERAGE, i.e. |P-N|/2 for a pair, so the constraint is half the limit.

(rule "mdi_skew_Ethernet_Pair0"
  (condition "A.inDiffPair('Ethernet_Pair0')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_ETH_MDI0"
  (condition "A.inDiffPair('ETH_MDI0')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_Ethernet_Pair1"
  (condition "A.inDiffPair('Ethernet_Pair1')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_ETH_MDI1"
  (condition "A.inDiffPair('ETH_MDI1')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_Ethernet_Pair2"
  (condition "A.inDiffPair('Ethernet_Pair2')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_ETH_MDI2"
  (condition "A.inDiffPair('ETH_MDI2')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_Ethernet_Pair3"
  (condition "A.inDiffPair('Ethernet_Pair3')")
  (constraint skew (max 0.075mm)))
(rule "mdi_skew_ETH_MDI3"
  (condition "A.inDiffPair('ETH_MDI3')")
  (constraint skew (max 0.075mm)))

# Hi-pot: all cable-side copper (ETH_SHIELD island, MDI cable nets, MCT taps, Bob Smith
# node) keeps >= 1.95 mm from GND on the plane layers (2.0 mm design split,
# 0.05 mm fill tolerance; 1500 Vrms 802.3 functional isolation).  Outer layers: the only
# cable-to-GND crossings are the R14/C15 1206 stitch parts by design.
(rule "eth_shield_split"
  (layer inner)
  (condition "(A.NetName == 'ETH_SHIELD' || A.NetName == 'ETH_BS' || A.NetName == 'ETH_MCT*' || A.NetName == 'ETH_MDI*') && B.NetName == 'GND'")
  (constraint clearance (min 1.95mm)))
# <<< Rev 9 Ethernet MDI rules <<<
